# STEMCraft Console

# Web server
STEMCRAFT_CONSOLE_HOST=127.0.0.1
STEMCRAFT_CONSOLE_PORT=8000

# Optional IANA timezone for automation (defaults to the server's system timezone).
# Examples: Australia/Brisbane, Australia/Sydney, America/New_York
STEMCRAFT_TIMEZONE=Australia/Brisbane

# Optional rclone config used by scheduled off-site backup copies.
# STEMCRAFT_RCLONE_CONFIG=/etc/stemcraft-console/rclone.conf
# STEMCRAFT_RCLONE_TIMEOUT_SECONDS=3600

# Set true after the panel is served through HTTPS.
STEMCRAFT_CONSOLE_COOKIE_SECURE=false

# Session signing
STEMCRAFT_CONSOLE_SECRET=change-me

# Database
STEMCRAFT_CONSOLE_DATABASE=stemcraft-console.db

# Minecraft server storage
STEMCRAFT_CONSOLE_SERVER_ROOT=minecraft-servers
