[Unit]
Description=STEMCraft Console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stemcraft
Group=stemcraft
WorkingDirectory=/opt/stemcraft-console
EnvironmentFile=-/etc/stemcraft-console/console.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/stemcraft-console/.venv/bin/python -m app.run
Restart=on-failure
RestartSec=5
UMask=0027
LimitNOFILE=65536
RuntimeDirectory=stemcraft-console
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/stemcraft-console /var/lib/stemcraft-console /srv/minecraft /run/stemcraft-console

[Install]
WantedBy=multi-user.target
