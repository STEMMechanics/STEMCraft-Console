// Permit the unprivileged console service to manage only STEMCraft server units.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        subject.user == "stemcraft") {
        var unit = action.lookup("unit");
        if (unit && /^stemcraft-server@[A-Za-z0-9][A-Za-z0-9_.@-]{0,127}\.service$/.test(unit)) {
            return polkit.Result.YES;
        }
    }
});
